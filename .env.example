CONTACT_TO_EMAIL=syednadealihashamshah@gmail.com

# Optional: custom domain for social previews (auto-detected on Vercel if omitted)
# NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Recommended for production: https://resend.com
RESEND_API_KEY=
# Use onboarding@resend.dev for testing (only sends to your Resend account email).
# For production, verify your domain in Resend and use e.g.:
# RESEND_FROM_EMAIL="Nade Ali Hasham <contact@yourdomain.com>"
RESEND_FROM_EMAIL=

# Secret for /admin/messages page (choose any long random string)
ADMIN_SECRET=

# Optional fallback: Gmail App Password or any SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Nade Portfolio <syednadealihashamshah@gmail.com>"

# Optional alternative: https://web3forms.com access key
WEB3FORMS_ACCESS_KEY=

# Without Resend/SMTP/Web3Forms, FormSubmit.co is used as fallback.
# First contact submission may require one-time email confirmation.
